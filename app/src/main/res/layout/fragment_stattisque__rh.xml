<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Stattisque_Rh">


    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:paddingHorizontal="40dp"
        android:paddingBottom="40dp"
        android:text="bienvenue rh "
        android:textAllCaps="true"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/skyBlue"

        />

    <TextView
        android:id="@+id/le_texte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="voici les statistiques "
        android:layout_marginHorizontal="40dp"
        android:paddingHorizontal="40dp"
        android:paddingTop="20dp"
        android:textAllCaps="true"
        />
    <Spinner

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:padding="20dp"
        android:id="@+id/poure"
        />

    <LinearLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="1370dp"
        android:layout_marginTop="100dp"
        android:orientation="vertical"
        >
            <LinearLayout
                android:paddingStart="10dp"
                android:background="@color/gris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nombre de retards:"
                    android:textSize="20dp"/>
                <TextView
                    android:id="@+id/nombre_retards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginStart="10dp"
                    android:textSize="20dp"/>
            </LinearLayout>

        <LinearLayout
            android:paddingStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@color/gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nombre d'absence:"
                android:textSize="20dp"/>
            <TextView
                android:id="@+id/nombre_absence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="10dp"
                android:textSize="20dp"/>
        </LinearLayout>

        <LinearLayout
            android:paddingStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@color/gris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jours le plus manqué: "
                android:textSize="20dp"/>
            <TextView
                android:id="@+id/jour_manque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginStart="10dp"
                android:textSize="20dp"/>
        </LinearLayout>


    </LinearLayout>


</FrameLayout>